      }
    },
    {
      "index": 60,
      "tag": "h2",
      "attrs": {
        "id": "using-embeds"
      },
      "text": "Using Embeds",
      "location": {
        "start": 166599,
        "end": 166649
      }
    },
    {
      "index": 61,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166649,
        "end": 166650
      }
    },
    {
      "index": 62,
      "tag": "p",
      "attrs": {},
      "text": "Sometimes we use a special Discord \"embed\" to format messages in a pretty way - these are written in JSON. When inside a JSON, common punctuation like bullets or new lines will not work as normal; use the following to achieve what you are looking for:",
      "location": {
        "start": 166650,
        "end": 166908
      }
    },
    {
      "index": 63,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166908,
        "end": 166909
      }
    },
    {
      "index": 64,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 166909,
        "end": 166924
      }
    },
    {
      "index": 65,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166924,
        "end": 166925
      }
    },
    {
      "index": 66,
      "tag": "p",
      "attrs": {},
      "text": "⬥ \\n → adds a new line",
      "location": {
        "start": 166925,
        "end": 166984
      }
    },
    {
      "index": 67,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166984,
        "end": 166985
      }
    },
    {
      "index": 68,
      "tag": "p",
      "attrs": {},
      "text": "⬥ \\u00a0\\u00a0\\u00a0\\u00a0 = adds a new line + 4 spaces",
      "location": {
        "start": 166985,
        "end": 167077
      }
    },
    {
      "index": 69,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167077,
        "end": 167078
      }
    },
    {
      "index": 70,
      "tag": "p",
      "attrs": {},
      "text": "⬥ \\n⬥ → adds a new line + a bullet",
      "location": {
        "start": 167078,
        "end": 167149
      }
    },
    {
      "index": 71,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167149,
        "end": 167150
      }
    },
    {
      "index": 72,
      "tag": "p",
      "attrs": {},
      "text": "⬥ \\n\\u00a0\\u00a0\\u00a0\\u00a0• → adds a new line + 4 spaces + a sub-bullet",
      "location": {
        "start": 167150,
        "end": 167260
      }
    },
    {
      "index": 73,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167260,
        "end": 167261
      }
    },
    {
      "index": 74,
      "tag": "p",
      "attrs": {},
      "text": "⬥ \\n\\u200B → adds a blank line",
      "location": {
        "start": 167261,
        "end": 167328
      }
    },
    {
      "index": 75,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167328,
        "end": 167329
      }
    },
    {
      "index": 76,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 167329,
        "end": 167344
      }
    },
    {
      "index": 77,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167344,
        "end": 167345
      }
    },
    {
      "index": 78,
      "tag": "p",
      "attrs": {},
      "text": "A example embed can be seen below:",
      "location": {
        "start": 167345,
        "end": 167386
      }
    },
    {
      "index": 79,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167386,
        "end": 167387
      }
    },
    {
      "index": 80,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 167387,
        "end": 167402
      }
    },
    {
      "index": 81,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167402,
        "end": 167403
      }
    },
    {
      "index": 82,
      "tag": "pre",
      "attrs": {},
      "text": "..\n{\n  \"embed\": {\n    \"title\": \"__[embed title]__\",\n    \"description\": \"[embed description]\\n\\u200B\",\n    \"color\": 39423,\n    \"fields\": [\n      {\n        \"name\": \"__[field 1 name]__\",\n        \"value\": \"[field 1 contents]\"\n      },\n      {\n        \"name\": \"__[field 2 name]__\",\n        \"value\": \"⬥ Field 2 contents\\n⬥ Field 2 contents\"\n      }\n    ]\n  }\n}\n..embed:json\n",
      "location": {
        "start": 167403,
        "end": 167945
      }
    },
    {
      "index": 83,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167945,
        "end": 167946
      }
    },
    {
      "index": 84,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 167946,
        "end": 167961
      }
    },
    {
      "index": 85,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 167961,
        "end": 167962
      }
    },
    {
      "index": 86,
      "tag": "p",
      "attrs": {},
      "text": "When rendered, the above code looks like the following;",
      "location": {
        "start": 167962,
        "end": 168024
      }
    },
    {
      "index": 87,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 168024,
        "end": 168025
      }
    },
    {
      "index": 88,
      "tag": "div",
      "attrs": {
        "class": "flex-vertical whitney theme-dark"
      },
      "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n[embed title]\n\n[embed description]\n​\n\n[field 1 name]\n[field 1 contents]\n[field 2 name]\n⬥ Field 2 contents\n⬥ Field 2 contents\n\n\n\n\n\n\n",
      "location": {
        "start": 168025,
        "end": 169177
      }
    },
    {
      "index": 89,
      "tag": "#text",
      "attrs": {},
      "text": "\n\n",
      "location": {
        "start": 169177,
        "end": 169179
      }
    },
    {
      "index": 90,

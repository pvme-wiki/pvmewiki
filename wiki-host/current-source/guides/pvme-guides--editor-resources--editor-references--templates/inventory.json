      }
    },
    {
      "index": 30,
      "tag": "p",
      "attrs": {},
      "text": "There are two ways to find an emoji:",
      "location": {
        "start": 165238,
        "end": 165281
      }
    },
    {
      "index": 31,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165281,
        "end": 165282
      }
    },
    {
      "index": 32,
      "tag": "ol",
      "attrs": {},
      "text": "\n\nIn the Guide Editor, simply start typing :emojiname ‎and it will bring up a list - select the one you want\n\n\nSearch the full repository of emojis at https://pvme.io/pvme-settings/#emojis\n\n",
      "location": {
        "start": 165282,
        "end": 165578
      }
    },
    {
      "index": 33,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165578,
        "end": 165579
      }
    },
    {
      "index": 34,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 165579,
        "end": 165594
      }
    },
    {
      "index": 35,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165594,
        "end": 165595
      }
    },
    {
      "index": 36,
      "tag": "h2",
      "attrs": {
        "id": "linking-items-to-the-wiki"
      },
      "text": "Linking items to the Wiki",
      "location": {
        "start": 165595,
        "end": 165671
      }
    },
    {
      "index": 37,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165671,
        "end": 165672
      }
    },
    {
      "index": 38,
      "tag": "p",
      "attrs": {},
      "text": "Many of our guides link items and gear to the RS Wiki. Follow these steps:",
      "location": {
        "start": 165672,
        "end": 165791
      }
    },
    {
      "index": 39,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165791,
        "end": 165792
      }
    },
    {
      "index": 40,
      "tag": "p",
      "attrs": {},
      "text": "⬥ Use the pattern: [Item name](<http://runescape.wiki/w/Item_name>) <:emoji:>​",
      "location": {
        "start": 165792,
        "end": 165909
      }
    },
    {
      "index": 41,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165909,
        "end": 165910
      }
    },
    {
      "index": 42,
      "tag": "p",
      "attrs": {},
      "text": "‎ ‎ ‎ ‎• Wrap the URL in <> ‎to prevent it showing a preview",
      "location": {
        "start": 165910,
        "end": 165996
      }
    },
    {
      "index": 43,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165996,
        "end": 165997
      }
    },
    {
      "index": 44,
      "tag": "p",
      "attrs": {},
      "text": "‎ ‎ ‎ ‎• Most items only capitalise the first word",
      "location": {
        "start": 165997,
        "end": 166054
      }
    },
    {
      "index": 45,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166054,
        "end": 166055
      }
    },
    {
      "index": 46,
      "tag": "p",
      "attrs": {},
      "text": "‎ ‎ ‎ ‎• Replace spaces with underscores",
      "location": {
        "start": 166055,
        "end": 166102
      }
    },
    {
      "index": 47,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166102,
        "end": 166103
      }
    },
    {
      "index": 48,
      "tag": "p",
      "attrs": {},
      "text": "⬥ Test your URL in the guide editor by clicking on it",
      "location": {
        "start": 166103,
        "end": 166163
      }
    },
    {
      "index": 49,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166163,
        "end": 166164
      }
    },
    {
      "index": 50,
      "tag": "p",
      "attrs": {},
      "text": "​",
      "location": {
        "start": 166164,
        "end": 166179
      }
    },
    {
      "index": 51,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166179,
        "end": 166180
      }
    },
    {
      "index": 52,
      "tag": "p",
      "attrs": {},
      "text": "See the following example:",
      "location": {
        "start": 166180,
        "end": 166213
      }
    },
    {
      "index": 53,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166213,
        "end": 166214
      }
    },
    {
      "index": 54,
      "tag": "p",
      "attrs": {},
      "text": "​[Channeller's ring](<http://runescape.wiki/w/Channeller's_ring>) <:channellersring:839903943404027914>​",
      "location": {
        "start": 166214,
        "end": 166364
      }
    },
    {
      "index": 55,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166364,
        "end": 166365
      }
    },
    {
      "index": 56,
      "tag": "p",
      "attrs": {},
      "text": "→ Channeller's ring ",
      "location": {
        "start": 166365,
        "end": 166582
      }
    },
    {
      "index": 57,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 166582,
        "end": 166583
      }
    },
    {
      "index": 58,
      "tag": "p",

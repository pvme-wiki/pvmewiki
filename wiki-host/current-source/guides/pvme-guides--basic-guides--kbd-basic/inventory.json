    },
    {
      "index": 32,
      "tag": "p",
      "attrs": {},
      "text": "The King Black Dragon's mechanics are mostly accounted for via good preparation such as bringing protection from dragonfire. During the fight you'll be largely focused on dealing good damage.",
      "location": {
        "start": 169361,
        "end": 169559
      }
    },
    {
      "index": 33,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 169559,
        "end": 169560
      }
    },
    {
      "index": 34,
      "tag": "p",
      "attrs": {},
      "text": "⬥ If you have access to , use it and stand in melee distance.",
      "location": {
        "start": 169560,
        "end": 169765
      }
    },
    {
      "index": 35,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 169765,
        "end": 169766
      }
    },
    {
      "index": 36,
      "tag": "p",
      "attrs": {},
      "text": "⬥ Don't forget to use any damage-boosting prayers you have available!",
      "location": {
        "start": 169766,
        "end": 169842
      }
    },
    {
      "index": 37,

    {
      "index": 8,
      "tag": "p",
      "attrs": {},
      "text": "A powerful three-headed dragon residing north-west of the Edgeville lodestone. The King Black Dragon (KBD)  is an iconic lower-level boss suitable for players with tier 50-70 gear. His attacks involve dealing with high-damage Dragonfire and other elemental breath attacks.",
      "location": {
        "start": 163533,
        "end": 163922
      }
    },
    {
      "index": 9,
      "tag": "#text",
      "attrs": {},

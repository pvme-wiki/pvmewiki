    {
      "index": 40,
      "tag": "p",
      "attrs": {},
      "text": "Your options for dealing damage will vary greatly depending on your gear and unlocked abilities. The below are guidelines, assuming no expensive unlocks.",
      "location": {
        "start": 169859,
        "end": 170019

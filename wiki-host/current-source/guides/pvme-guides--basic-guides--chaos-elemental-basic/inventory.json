    {
      "index": 8,
      "tag": "p",
      "attrs": {},
      "text": "A being of pure chaos that resides to the west of the Rogues' Castle located in deep Wilderness. The Chaos Elemental is a beginner-friendly boss with simple mechanics meant to disorient the player more than harm them.",
      "location": {
        "start": 164011,
        "end": 164235

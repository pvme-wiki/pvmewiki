      "location": {
        "start": 164310,
        "end": 164311
      }
    },
    {
      "index": 14,
      "tag": "p",
      "attrs": {},
      "text": "WARNING: THIS BOSS IS LOCATED IN THE WILDERNESS, BE SURE TO HAVE PVP TOGGLED OFF BEFORE ATTEMPTING TO FIGHT IT.",
      "location": {
        "start": 164311,
        "end": 164455
      }
    },
    {
      "index": 15,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 164455,
        "end": 164456
      }
    },
    {
      "index": 16,

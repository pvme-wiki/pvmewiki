    {
      "index": 36,
      "tag": "p",
      "attrs": {},
      "text": "Glacors can be found at the Elder God Wars Dungeon, Glacor Cave, and Frozen Plateau (Wilderness), but are best killed at the Elder God Wars Dungeon due to dropping  and being generally easier to AFK.",
      "location": {
        "start": 166200,
        "end": 166540

        "start": 166540,
        "end": 166541
      }
    },
    {
      "index": 38,
      "tag": "p",
      "attrs": {},
      "text": "‎ ‎ ‎ ‎• The Glacor Front of the EGWD can be accessed quickly using a boss portal leading to Arch-Glacor.",
      "location": {
        "start": 166541,
        "end": 166653
      }
    },
    {
      "index": 39,

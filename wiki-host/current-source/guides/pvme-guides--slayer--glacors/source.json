        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "eldertrovewent3",
          "class": "d-emoji",
          "alt": "eldertrovewent3",
          "src": "https://cdn.discordapp.com/emojis/869284271452479488.png?v=1"
        },
        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 166367,
          "end": 166501
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": " and being generally easier to AFK.",
        "location": {
          "start": 166501,
          "end": 166536

      {
        "nodeName": "#text",
        "text": "Glacors can be found at the Elder God Wars Dungeon, Glacor Cave, and Frozen Plateau (Wilderness), but are best killed at the Elder God Wars Dungeon due to dropping ",
        "location": {
          "start": 166203,
          "end": 166367

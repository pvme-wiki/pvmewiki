      "location": {
        "start": 165515,
        "end": 165516
      }
    },
    {
      "index": 12,
      "tag": "p",
      "attrs": {},
      "text": "⬥ This guides aims to get you started on doing Barrows runs, and will focus on the original six brothers.",
      "location": {
        "start": 165516,
        "end": 165628
      }
    },
    {
      "index": 13,
      "tag": "#text",
      "attrs": {},
      "text": "\n",
      "location": {
        "start": 165628,
        "end": 165629
      }
    },
    {
      "index": 14,
      "tag": "p",
      "attrs": {},
      "text": "‎ ‎ ‎ ‎• It will be assumed that you're using Magic  and the entry-level preset.",
      "location": {
        "start": 165629,
        "end": 165830
      }
    },
    {
      "index": 15,
      "tag": "#text",

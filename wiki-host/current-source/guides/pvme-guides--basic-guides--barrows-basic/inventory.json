    {
      "index": 8,
      "tag": "p",
      "attrs": {},
      "text": "The Barrows Brothers  were originally composed of six wights, two more members were added after completing the Ritual of the Mahjarrat and Kindred Spirits quests.",
      "location": {
        "start": 165088,
        "end": 165499

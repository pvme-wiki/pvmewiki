    {
      "index": 42,
      "tag": "h2",
      "attrs": {
        "id": "mechanics"
      },
      "text": "Mechanics",
      "location": {
        "start": 170156,
        "end": 170200
      }
    },
    {
      "index": 43,
      "tag": "#text",
      "attrs": {},

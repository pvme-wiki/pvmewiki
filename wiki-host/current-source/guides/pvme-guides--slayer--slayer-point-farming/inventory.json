    {
      "index": 6,
      "tag": "p",
      "attrs": {},
      "text": "⬥ Slayer Points are a currency obtained by completing Slayer Assignments which have several uses, such as skipping Slayer Assignments, purchasing consumables such as , and purchasing permanent unlocks at Slayer Masters.",
      "location": {
        "start": 163573,
        "end": 163918

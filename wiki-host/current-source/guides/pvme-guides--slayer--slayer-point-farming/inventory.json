        "start": 163918,
        "end": 163919
      }
    },
    {
      "index": 8,
      "tag": "p",
      "attrs": {},
      "text": "⬥ This mini-guide will outline a method of effectively farming these points without having to complete lengthy, high levelled Slayer Assignments.",
      "location": {
        "start": 163919,
        "end": 164071
      }
    },
    {

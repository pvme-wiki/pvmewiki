        "start": 164837,
        "end": 164838
      }
    },
    {
      "index": 26,
      "tag": "p",
      "attrs": {},
      "text": "⬥ Copy the blocklist below to ensure that all Slayer Assignments given by Jacquelyn will be to slay monsters present in the Lumbridge Catacombs.",
      "location": {
        "start": 164838,
        "end": 164989
      }
    },
    {
      "index": 27,

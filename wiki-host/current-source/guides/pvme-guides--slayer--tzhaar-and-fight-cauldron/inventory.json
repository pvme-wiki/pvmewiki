    {
      "index": 54,
      "tag": "h2",
      "attrs": {
        "id": "overview-of-the-fight-cauldron"
      },
      "text": "Overview of the Fight Cauldron",
      "location": {
        "start": 170980,
        "end": 171066
      }
    },
    {
      "index": 55,
      "tag": "#text",
      "attrs": {},

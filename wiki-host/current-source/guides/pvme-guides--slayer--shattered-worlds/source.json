    "children": [
      {
        "nodeName": "#text",
        "text": "‎ ‎ ‎ ‎• To farm anima efficiently, skipping worlds is the priority. However, due to RNG in the objectives, skipping 2 worlds is often more achievable.",
        "location": {
          "start": 167690,
          "end": 167841
        }
      }
    ]
  },
  {
    "nodeName": "#text",

        "location": {
          "start": 168199,
          "end": 168318
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": ", stored in an Essence of Finality necklace ",
        "location": {
          "start": 168318,
          "end": 168362
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "eof",

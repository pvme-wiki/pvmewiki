    "children": [
      {
        "nodeName": "#text",
        "text": "⬥ Soulsplit ",
        "location": {
          "start": 170746,
          "end": 170758
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "soulsplit",
          "class": "d-emoji",
          "alt": "soulsplit",

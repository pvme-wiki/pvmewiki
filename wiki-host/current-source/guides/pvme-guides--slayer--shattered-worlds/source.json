        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 168362,
          "end": 168472
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": " to allow it to be used with Mechanical chinchompas ",
        "location": {
          "start": 168472,
          "end": 168524
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "mechchin",
          "class": "d-emoji",
          "alt": "mechchin",

        },
        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 170758,
          "end": 170880
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": " is used for all healing, as the massive damage dealt generates a lot of healing. Solid food is also recommended, as adrenaline is effectively infinite, alongside healing a large amount in one bite and therefore has no downside.",
        "location": {
          "start": 170880,
          "end": 171108
        }
      }
    ]
  },

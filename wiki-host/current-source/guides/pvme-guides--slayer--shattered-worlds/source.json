    },
    "children": [
      {
        "nodeName": "#text",
        "text": "⬥ The best worlds to farm are 101-105, due to them starting with the Feeling Pumped modifier, and having low HP mobs.",
        "location": {
          "start": 167063,
          "end": 167180
        }
      }
    ]
  },
  {
    "nodeName": "#text",
    "text": "\n",
    "location": {
      "start": 167184,
      "end": 167185
    }
  },
  {
    "nodeName": "p",
    "tag": "p",
    "attrs": {},
    "namespace": "http://www.w3.org/1999/xhtml",
    "location": {
      "start": 167185,
      "end": 167385
    },
    "children": [
      {
        "nodeName": "#text",
        "text": "‎ ‎ ‎ ‎• Feeling Pumped gives the player unlimited adrenaline for 10s upon activation, which allows the player to deal massive damage in a short time, and is required for this style of farming.",
        "location": {
          "start": 167188,
          "end": 167381
        }
      }
    ]
  },
  {
    "nodeName": "#text",
    "text": "\n",
    "location": {
      "start": 167385,
      "end": 167386
    }
  },
  {

  {
    "nodeName": "p",
    "tag": "p",
    "attrs": {},
    "namespace": "http://www.w3.org/1999/xhtml",
    "location": {
      "start": 170314,
      "end": 170726
    },
    "children": [
      {
        "nodeName": "#text",
        "text": "⬥ The usage of Target Cycling is heavily recommended. This is due to auto-attacks stalling repeated Essence of Finality special attacks ",
        "location": {
          "start": 170317,
          "end": 170453
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "eofspec",
          "class": "d-emoji",
          "alt": "eofspec",
          "src": "https://cdn.discordapp.com/emojis/1257438999794946099.png?v=1"
        },
        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 170453,
          "end": 170572
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": ", preventing you from continuously speccing whilst Feeling Pumped is active. Targets can still be clicked if the player is careful not to auto-attack.",
        "location": {
          "start": 170572,
          "end": 170722
        }
      }
    ]
  },
  {
    "nodeName": "#text",

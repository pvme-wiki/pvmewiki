    },
    "children": [
      {
        "nodeName": "#text",
        "text": "⬥ As speed is the most important factor here, Acceleration potions ",
        "location": {
          "start": 169759,
          "end": 169826
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "powerburstofacceleration",
          "class": "d-emoji",
          "alt": "powerburstofacceleration",
          "src": "https://cdn.discordapp.com/emojis/756236265472524418.png?v=1"
        },
        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 169826,
          "end": 169978
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": " can be particularly helpful for clearing large distances, to get to more enemies or to rush to the portal after finishing an objective. If getting to the portal quicker will help with world skips, use it, otherwise save it for the next world where it may come in more useful, this is up to the player's discretion.",
        "location": {
          "start": 169978,
          "end": 170293
        }
      }
    ]
  },
  {
    "nodeName": "#text",
    "text": "\n",
    "location": {
      "start": 170297,
      "end": 170298
    }
  },
  {
    "nodeName": "p",
    "tag": "p",
    "attrs": {},
    "namespace": "http://www.w3.org/1999/xhtml",
    "location": {
      "start": 170298,
      "end": 170313
    },
    "children": [
      {
        "nodeName": "#text",
        "text": "​",
        "location": {
          "start": 170301,
          "end": 170309
        }
      }
    ]
  },
  {
    "nodeName": "#text",

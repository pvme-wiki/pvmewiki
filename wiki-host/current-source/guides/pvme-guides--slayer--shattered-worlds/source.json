        "location": {
          "start": 168524,
          "end": 168644
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": ", allowing the player to often one-hit large groups of enemies. If Feeling Pumped has not activated yet, simply use basic abilities or thresholds like Snapshot ",
        "location": {
          "start": 168644,
          "end": 168804
        }
      },
      {
        "nodeName": "img",
        "tag": "img",
        "attrs": {
          "title": "snap",
          "class": "d-emoji",
          "alt": "snap",
          "src": "https://cdn.discordapp.com/emojis/535534127131394088.png?v=1"
        },
        "namespace": "http://www.w3.org/1999/xhtml",
        "location": {
          "start": 168804,
          "end": 168916
        },
        "children": []
      },
      {
        "nodeName": "#text",
        "text": ". An example video is shown below featuring various world skips.",
        "location": {
          "start": 168916,
          "end": 168980
        }
      }
    ]
  },

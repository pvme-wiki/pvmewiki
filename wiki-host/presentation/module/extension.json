{
  "name": "PvmePresentation",
  "version": "1.0.0",
  "author": "PvME Wiki contributors",
  "url": "https://github.com/pvme-wiki/pvmewiki",
  "description": "Guide navigation, source attribution and RuneScape Wiki export for the PvME guide pages.",
  "license-name": "GPL-2.0-or-later",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\PvmePresentation\\": "includes/"
  },
  "HookHandlers": {
    "sourceMediaTags": {
      "factory": "MediaWiki\\Extension\\PvmePresentation\\SourceMediaTags::newFromModuleFiles"
    },
    "guidePageDisplay": {
      "factory": "MediaWiki\\Extension\\PvmePresentation\\GuidePageDisplay::newFromModuleFiles"
    }
  },
  "Hooks": {
    "ParserFirstCallInit": "sourceMediaTags",
    "BeforePageDisplay": "guidePageDisplay"
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "PvmePresentation"
  },
  "ResourceModules": {
    "ext.pvmePresentation.reader": {
      "packageFiles": [
        "modules/reader/index.js",
        "modules/reader/dom.js",
        "modules/reader/page.js",
        "modules/reader/native-title.js",
        "modules/reader/toolbar.js",
        "modules/reader/source-freshness.js",
        "modules/reader/source-footer.js",
        "modules/reader/copy-to-wiki.js",
        "modules/reader/index-page-styling.js",
        "modules/navigation.json"
      ],
      "dependencies": [
        "mediawiki.util",
        "mediawiki.api"
      ]
    },
    "ext.pvmePresentation.wikiExport": {
      "packageFiles": [
        "modules/export/index.js",
        "modules/export/export-revision.js",
        "modules/export/published-markup.js",
        "modules/export/media-routes.js",
        "modules/export/media-markup.js",
        "modules/export/render-guide.js",
        "modules/export/wikitext.js",
        "modules/wiki-media-resolver.json"
      ]
    },
    "ext.pvmePresentation.styles": {
      "styles": [
        "modules/presentation.css",
        "modules/amascut-pictures.css",
        "modules/amascut-main.css"
      ]
    }
  },
  "manifest_version": 2
}

{
  "name": "PvmePresentation",
  "version": "0.4.0",
  "author": "PvME Wiki contributors",
  "url": "https://github.com/pvme-wiki/pvme",
  "description": "Scoped presentation styles for the standalone PvME guide corpus.",
  "license-name": "GPL-2.0-or-later",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.43.0"
  },
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\PvmePresentation\\": "includes/"
  },
  "Hooks": {
    "ParserFirstCallInit": "MediaWiki\\Extension\\PvmePresentation\\Hooks::onParserFirstCallInit",
    "BeforePageDisplay": "MediaWiki\\Extension\\PvmePresentation\\Hooks::onBeforePageDisplay"
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "PvmePresentation"
  },
  "ResourceModules": {
    "ext.pvmePresentation.reader.v4": {
      "packageFiles": [
        "modules/reader.js",
        "modules/navigation.json",
        "modules/wiki-export.js",
        "modules/visual-reader.js",
        "modules/presets.json",
        "modules/action-bars.json",
        "modules/amascut-visuals.js",
        "modules/amascut-assets.json"
      ],
      "dependencies": [
        "mediawiki.util",
        "mediawiki.api"
      ]
    },
    "ext.pvmePresentation.styles.v4": {
      "styles": [
        "modules/presentation.css",
        "modules/amascut-pictures.css",
        "modules/amascut-main.css"
      ]
    }
  },
  "manifest_version": 2
}

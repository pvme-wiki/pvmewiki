        {
          "blockId": "zamorak:b:000037",
          "text": "Zamorak begins to draw power and energy from something within Infernus."
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "The world will burn."
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "I will tear you asunder!"
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "Feel the rage of a god."
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "Step into the dark... meet your death."
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "Chaos, unfettered!"
        },
        {
          "blockId": "zamorak:b:000037",
          "text": "You're already dead."
        }

      "cues": [
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "The Queen Black Dragon takes a huge breath."
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "The Queen Black Dragon summons one of her Captured Souls."
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "The Queen Black Dragon starts to siphon the energy of her mages."
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "Time is short!"
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "She is pouring her energy into me...hurry!"
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "The spell is nearly complete!"
        },
        {
          "blockId": "pvme-guides--rs3-full-boss-guides--queen-black-dragon:b:000025",
          "text": "The Queen Black Dragon gathers her strength to breathe extremely hot flames."
        }
      ],

      "cues": [
        {
          "blockId": "pvme-guides--basic-guides--giant-mole-basic:b:000013",
          "text": "The Giant Mole calls for aid."
        },
        {
          "blockId": "pvme-guides--basic-guides--giant-mole-basic:b:000013",
          "text": "The mole can now be stunned."
        },
        {
          "blockId": "pvme-guides--basic-guides--giant-mole-basic:b:000013",
          "text": "The mole seems to regain her balance."
        },
        {
          "blockId": "pvme-guides--basic-guides--giant-mole-basic:b:000013",
          "text": "You hear a crumbling noise above."
        },
        {
          "blockId": "pvme-guides--basic-guides--giant-mole-basic:b:000013",
          "text": "The Giant Mole strikes a mighty blow, shattering your muddy prison."
        }
      ],

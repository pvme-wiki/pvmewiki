    "differencesExcludingH1": [
      {
        "index": 2,
        "old": "The aim of this guide is to provide a basic overview of how to get consistent kills at Amascut, the Devourer. Due to the boss' high defence levels, demanding DPS checks and mechanical complexity, contents of this guide assume you have at least made it to the end of Stage 1 of Upgrade guides for your chosen style. As Amascut is enrage-based with fixed enrages of 100, 500, 750, 1000, 2000 and 4000%, mechanics and strategies may differ based on enrage. For the purposes of this guide, 100% enrage will be utilized.",
        "current": "The aim of this guide is to provide a basic overview of how to get consistent kills at Amascut, the Devourer. Due to the boss' high defence levels, demanding DPS checks and mechanical complexity, contents of this guide assume you have at least made it to the end of Stage 1 of #upgrade-order for your chosen style. As Amascut is enrage-based with fixed enrages of 100, 500, 750, 1000, 2000 and 4000%, mechanics and strategies may differ based on enrage. For the purposes of this guide, 100% enrage will be utilized.",
        "currentHtml": "<p>The aim of this guide is to provide a basic overview of how to get consistent kills at Amascut, the Devourer. Due to the boss' high defence levels, demanding DPS checks and mechanical complexity, contents of this guide assume you have at least made it to the end of Stage 1 of <a href=\"\" class=\"inactiveLink\">#upgrade-order</a> for your chosen style. As Amascut is enrage-based with fixed enrages of 100, 500, 750, 1000, 2000 and 4000%, mechanics and strategies may differ based on enrage. For the purposes of this guide, 100% enrage will be utilized.</p>"
      }
    ],

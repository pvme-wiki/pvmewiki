{
  "name": "pvme-platform",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build-fullstack.mjs",
    "test": "node --test scripts/*.test.mjs server/tests/*.test.mjs",
    "test:theme": "node scripts/test_night_mode.mjs",
    "db:migrate": "node server/manage.mjs migrate",
    "db:seed": "node server/manage.mjs seed",
    "verify": "npm test && npm --prefix editor test && npm run test:theme",
    "dev": "node scripts/dev-server.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/markdown": "1.8.1",
    "diff": "9.0.0",
    "markdown-it": "15.0.3",
    "minisearch": "7.2.0",
    "pg": "8.16.3",
    "tom-select": "2.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "esbuild": "0.28.2"
  }
}

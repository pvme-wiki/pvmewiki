{
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "codex/public-bootstrap-review-flow": false,
      "codex/owner-public-snapshot": false
    }
  },
  "buildCommand": "npm run build && npm run verify && node scripts/check-publication.mjs",
  "installCommand": "npm ci --include=dev",
  "outputDirectory": "dist",
  "functions": {
    "api/editor.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/editor/:path*",
      "destination": "/api/editor?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/edit/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self'; font-src 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/data/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/editor/jobs/publication",
      "schedule": "0 3 * * *"
    }
  ]
}
